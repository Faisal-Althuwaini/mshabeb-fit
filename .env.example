# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Supabase: create a project at https://supabase.com, then copy from Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: DeepSeek for free-text parsing ("112.4 وحديد وأكلت برا"). Without it, unknown text is ignored.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Web Push (PWA notifications). Generate once: npx web-push generate-vapid-keys
# The public key also goes into the PWA as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
