# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Supabase: create a project at https://supabase.com, then copy from Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional LLM via OpenRouter (free-text parsing, nudge wording). Without a key: templates only.
OPENROUTER_API_KEY=
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_FALLBACK_MODELS=openai/gpt-oss-120b

# Web Push (PWA notifications). Generate once: npx web-push generate-vapid-keys
# The public key also goes into the PWA as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
